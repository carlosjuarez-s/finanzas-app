# Postgres (Neon / Supabase / Vercel Postgres)
DATABASE_URL="postgresql://..."

# API key de Anthropic (console.anthropic.com). Proveedor principal.
ANTHROPIC_API_KEY="sk-ant-..."

# Respaldo: si falta la key de Anthropic o se agota el credito, la extraccion
# cae automaticamente a Gemini (aistudio.google.com, tier gratuito). Opcional.
# Ojo: en el tier gratuito Google usa lo que mandes para entrenar sus modelos,
# con revision humana incluida, y aca van resumenes de tarjeta y recibos.
GEMINI_API_KEY=""

# Opcionales: sobreescriben el modelo de cada proveedor.
# ANTHROPIC_MODEL="claude-sonnet-4-6"
# GEMINI_MODEL="gemini-2.5-flash"

# JSON completo de la service account de Google (una sola linea)
# Google Cloud Console > IAM > Service Accounts > Keys > JSON
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# Nombres de las carpetas de Drive compartidas con la service account
DRIVE_FOLDER_TARJETAS="Resúmenes de tarjeta"
DRIVE_FOLDER_SALARIOS="Salarios"
DRIVE_FOLDER_INVERSIONES="Inversiones"

# Password de acceso a la app y secreto del cron de Vercel
APP_PASSWORD="elegi-una-fuerte"
CRON_SECRET="random-largo"
