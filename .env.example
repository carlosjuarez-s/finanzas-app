# Postgres (Neon / Supabase / Vercel Postgres)
DATABASE_URL="postgresql://..."

# API key de Anthropic (console.anthropic.com). Proveedor principal.
ANTHROPIC_API_KEY="sk-ant-..."

# Respaldo: si falta la key de Anthropic o se agota el credito, la extraccion
# cae automaticamente a Gemini (aistudio.google.com, tier gratuito). Opcional.
# Ojo: en el tier gratuito Google usa lo que mandes para entrenar sus modelos,
# con revision humana incluida, y aca van resumenes de tarjeta y recibos.
GEMINI_API_KEY=""

# Opcionales: sobreescriben el modelo de cada proveedor.
# ANTHROPIC_MODEL="claude-sonnet-4-6"
# GEMINI_MODEL="gemini-3.6-flash"

# JSON completo de la service account de Google (una sola linea)
# Google Cloud Console > IAM > Service Accounts > Keys > JSON
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# Nombres de las carpetas de Drive compartidas con la service account
DRIVE_FOLDER_TARJETAS="Resúmenes de tarjeta"
DRIVE_FOLDER_SALARIOS="Salarios"
DRIVE_FOLDER_INVERSIONES="Inversiones"

# Password de acceso a la app y secreto del cron de Vercel.
# APP_PASSWORD es el respaldo: se usa solo mientras el login con Google no este
# configurado. Con AUTH_GOOGLE_ID seteado, la app entra por Google y esta clave
# deja de servir.
APP_PASSWORD="elegi-una-fuerte"
CRON_SECRET="random-largo"

# Login con Google (Auth.js). Las tres van juntas: si falta alguna, la app
# vuelve al Basic Auth de APP_PASSWORD.
#
#   AUTH_SECRET: firma las cookies de sesion. Generar con
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
#   AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET: Google Cloud Console > APIs y
#     servicios > Credenciales > ID de cliente de OAuth (tipo "aplicacion web").
#     El URI de redireccion autorizado tiene que ser exactamente:
#       https://TU-DOMINIO/api/auth/callback/google
#
#   AUTH_EMAILS: quienes pueden entrar, separados por coma. Auth.js NO trae
#     esta restriccion: sin la lista, cualquiera con cuenta de Google entraria.
#     Vacia no deja entrar a nadie, a proposito.
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_EMAILS="vos@gmail.com"

# Boveda de credenciales de brokers (lib/boveda.ts). Cifra las API keys que se
# guardan en la base. NUNCA guardar esta clave en la base ni en el repo: es lo
# unico que separa un dump de Postgres de tus credenciales en claro.
#
# Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Para rotar: agregar BOVEDA_CLAVE_2, poner BOVEDA_CLAVE_ACTUAL=2 y correr
# rotarCifrado(). Hasta que termine, lo cifrado con la 1 se sigue leyendo.
BOVEDA_CLAVE_ACTUAL="1"
BOVEDA_CLAVE_1=""

# Servidor MCP (app/api/mcp). Permite conectar Claude Desktop o Claude Code a
# tus finanzas, en SOLO LECTURA: no hay ninguna herramienta que escriba.
#
# Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# El token que usa el cliente es "<tu-email>:<MCP_TOKEN>": el email dice de
# quien son los datos, el secreto autentica. Sin esta variable el endpoint
# responde 401 a todo.
MCP_TOKEN=""
