# Postgres (Neon / Supabase / Vercel Postgres)
DATABASE_URL="postgresql://..."

# API key de Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY="sk-ant-..."

# JSON completo de la service account de Google (una sola linea)
# Google Cloud Console > IAM > Service Accounts > Keys > JSON
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# Nombres de las carpetas de Drive compartidas con la service account
DRIVE_FOLDER_TARJETAS="Resúmenes de tarjeta"
DRIVE_FOLDER_SALARIOS="Salarios"
DRIVE_FOLDER_INVERSIONES="Inversiones"

# Password de acceso a la app y secreto del cron de Vercel
APP_PASSWORD="elegi-una-fuerte"
CRON_SECRET="random-largo"
